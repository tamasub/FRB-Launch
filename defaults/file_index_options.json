{
  "_index_mode_help": {
    "registered": "従来方式：ランチャー登録フォルダーを対象",
    "configured": "指定方式：index_foldersのフォルダーのみ対象",
    "off": "インデックス処理なし"
  },
  "enabled": true,
  "index_mode": "registered",
  "index_folders": [],
  "max_depth": -1,
  "extensions": [
    ".bat",
    ".ps1",
    ".json",
    ".xlsx",
    ".md",
    ".html"
  ],
  "exclude_name_contains": [],
  "exclude_directories": [
    ".venv",
    ".venv_backup",
    ".git",
    "node_modules",
    "__pycache__",
    "build",
    "dist",
    "System Volume Information",
    "$RECYCLE.BIN"
  ],
  "search_limit": 100,
  "update_mode": "auto",
  "auto_update": {
    "startup_delay_seconds": 300,
    "check_interval_minutes": 30,
    "max_scan_workers": 2
  },
  "exclude_directory_globs": [],
  "scan_error_policy": "preserve_cached",
  "index_target": "files"
}
