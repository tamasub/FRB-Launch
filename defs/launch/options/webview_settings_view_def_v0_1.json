{
  "app": {
    "name": "FRB Launch - ブラウザー設定",
    "version": "0.1",
    "presentation": { "preset": "launcher", "density": "compact", "shell": "minimal" }
  },
  "views": [
    {
      "id": "webview_options",
      "caption": "ブラウザー設定",
      "layout": "header-search-grid-detail",
      "sections": [
        {
          "id": "options",
          "caption": "ブラウザー設定",
          "type": "form",
          "dataPath": "$",
          "fields": [
            {
              "field": "mode",
              "caption": "Launch内部ブラウザーを利用する（再起動後に反映）",
              "type": "select",
              "options": [
                { "value": "embedded", "label": "有効" },
                { "value": "external", "label": "無効（外部ブラウザーで開く）" }
              ],
              "grid": { "visible": false },
              "edit": { "visible": true },
              "search": { "visible": false },
              "width": "FULL"
            },
            {
              "field": "remember_login",
              "caption": "ログイン状態を記憶する",
              "type": "boolean",
              "grid": { "visible": false },
              "edit": { "visible": true },
              "visibleWhen": { "field": "mode", "equals": "embedded" },
              "search": { "visible": false }
            },
            {
              "field": "new_tab_url",
              "caption": "新しいタブのURL",
              "type": "text",
              "grid": { "visible": false },
              "edit": { "visible": true },
              "visibleWhen": { "field": "mode", "equals": "embedded" },
              "search": { "visible": false },
              "width": "FULL"
            }
          ]
        }
      ]
    }
  ]
}
